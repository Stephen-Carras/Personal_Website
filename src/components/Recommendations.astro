---
// Recommendations: horizontal scroll-snap cards, newest first. Each card is rendered
// once; the script adds the loop clones (aria-hidden, not focusable) in phase 3.
// Quotes clamp to 5 lines behind "Read more" when JS is available.
import { inFileOrder } from '../lib/order';
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import { longDate } from '../lib/dates';

interface Props {
  heading: string;
  hint: string;
}
const recs = await inFileOrder('recommendations');
---

<section id="recommendations" class="sec">
  <div class="wrap">
    <h2 class="h2 rv-u">{Astro.props.heading}</h2>
    <div class="rv-z">
      <div class="track-bar">
        <span class="hint">
          {Astro.props.hint}
          <svg class="hint-a" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </span>
        <div class="gbtns">
          <button class="ib gb" type="button" data-track-prev="rectrack" aria-label="Previous recommendation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button class="ib gb" type="button" data-track-next="rectrack" aria-label="Next recommendation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
      <div id="rectrack" class="track rec-track" role="region" aria-label="Recommendations, scroll horizontally" tabindex="0" data-loop>
        {
          recs.map(({ id, data: r }) => {
            const photo = img(r.photo);
            return (
              <figure class="rec" id={`rec-${id}`}>
                <div class="rec-top">
                  <div class="rec-mark" aria-hidden="true">“</div>
                  <blockquote class="rec-q" id={`recq-${id}`}>
                    {r.quote.split(/\n\s*\n/).map((para, n) => (n ? [<br />, <br />, para] : para))}
                  </blockquote>
                  <button class="rm rec-more" type="button" aria-expanded="false" aria-controls={`recq-${id}`} data-rec-toggle>
                    Read more
                  </button>
                </div>
                <figcaption class="rec-by">
                  <Image src={photo.src} alt={photo.alt} width={56} height={56} densities={[1, 2]} loading="lazy" />
                  <div>
                    <a href={r.linkedin} target="_blank" rel="noopener noreferrer">
                      {r.name}
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                    <div class="rec-title">{r.title}</div>
                    <div class="rec-meta">
                      {longDate(r.date)} · {r.relation}
                    </div>
                  </div>
                </figcaption>
              </figure>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
