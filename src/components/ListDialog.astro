---
// Full-list pop-up for Beyond work (reading list, music). Same native modal <dialog>
// pattern as ContactDialog: the browser closes it on Escape and makes the page inert;
// scripts/dialogs.ts adds backdrop click, focus trap and focus return.
import ListRow from './ListRow.astro';

interface Props {
  id: string;
  title: string;
  subtitle: string;
  closeLabel: string;
  rows: { title: string; sub?: string; url?: string }[];
}
const { id, title, subtitle, closeLabel, rows } = Astro.props;
---

<dialog id={id} class="cmod cmod--list" aria-labelledby={`${id}-h`} aria-describedby={`${id}-p`}>
  <div class="cmod-in">
    <button class="ib cmod-x" type="button" data-close-dialog aria-label={closeLabel} autofocus>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <h2 id={`${id}-h`} class="cmod-h">{title}</h2>
    <p id={`${id}-p`} class="cmod-p">{subtitle}</p>
    <ul class="llist llist--dlg">
      {rows.map((r) => <ListRow {...r} />)}
    </ul>
  </div>
</dialog>
