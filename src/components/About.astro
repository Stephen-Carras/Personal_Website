---
// About: bold lead, then every body paragraph, all shown in full (no fold).
interface Props {
  about: {
    heading: string;
    lead: string;
    body: string;
    more: string[];
  };
}
const { about } = Astro.props;
---

<section id="about" class="sec">
  <div class="wrap">
    <h2 class="h2 srise">{about.heading}</h2>
    <div class="about">
      <p class="about-lead srise i1">{about.lead}</p>
      <p class="about-p srise-p">{about.body}</p>
      {about.more.map((p) => <p class="about-p srise-p">{p}</p>)}
    </div>
  </div>
</section>
