---
// About: bold lead, then every body paragraph, all shown in full (no fold).
// The heading and lead sit in .arun > .astage: with scroll-driven animations they pin
// under the nav and rise in (motion.css); everyone else sees the static layout.
// The paragraphs follow in normal flow (they are too long to pin).
interface Props {
  about: {
    heading: string;
    lead: string;
    body: string;
    more: string[];
  };
}
const { about } = Astro.props;
---

<section id="about" class="sec">
  <div class="arun">
    <div class="astage">
      <div class="wrap">
        <h2 class="h2 ahd">{about.heading}</h2>
        <p class="about-lead alead">{about.lead}</p>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="about about-rest">
      <p class="about-p srise-p">{about.body}</p>
      {about.more.map((p) => <p class="about-p srise-p">{p}</p>)}
    </div>
  </div>
</section>
