---
// About: bold lead, then every body paragraph, all shown in full (no fold).
// Entrance (motion.css): scroll-linked rise-in. Heading and lead use .rise-a, the
// paragraphs .rise-b.
interface Props {
  about: {
    heading: string;
    lead: string;
    body: string;
    more: string[];
  };
}
const { about } = Astro.props;
---

<section id="about" class="sec">
  <div class="wrap">
    <h2 class="h2 rise-a">{about.heading}</h2>
    <div class="about">
      <p class="about-lead rise-a">{about.lead}</p>
      <p class="about-p rise-b">{about.body}</p>
      {about.more.map((p) => <p class="about-p rise-b">{p}</p>)}
    </div>
  </div>
</section>
