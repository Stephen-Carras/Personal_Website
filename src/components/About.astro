---
// About: bold lead, one body paragraph, then "Read more +" reveals the rest. The toggle
// sits below the revealed text. Without JS the fold is simply open and the button hidden.
interface Props {
  about: {
    heading: string;
    lead: string;
    body: string;
    more: string[];
    moreLabel: string;
    lessLabel: string;
  };
}
const { about } = Astro.props;
---

<section id="about" class="sec">
  <div class="wrap">
    <h2 class="h2 rv-u">{about.heading}</h2>
    <div class="about">
      <p class="about-lead rv-u">{about.lead}</p>
      <p class="about-p rv-u i1">{about.body}</p>
      <div class="fold" id="about-more">
        {about.more.map((p) => <p class="about-p">{p}</p>)}
      </div>
      <button
        class="rm about-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="about-more"
        data-about-toggle
        data-more={about.moreLabel}
        data-less={about.lessLabel}
      >
        {about.moreLabel}
      </button>
    </div>
  </div>
</section>
