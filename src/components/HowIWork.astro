---
import { getEntry } from 'astro:content';

const h = (await getEntry('howIWork', 'main'))!.data;
// Wave section, like About (sections.css .wave): .bstage holds the title and the lead
// sentence, .bbody the six items. Entrance (motion.css): title, then lead, then the
// items. The bar cursor after the title is decorative (aria-hidden).
---

<section id="how" class="sec wave">
  <div class="wrap bstage">
    <h2 class="h2 rise-a">{h.heading}<span class="cur cur-bar" aria-hidden="true"></span></h2>
    <p class="lead-p rise-a">{h.lead}</p>
  </div>
  <div class="wrap bbody">
    <div class="how-grid">
      {
        h.items.map((it, n) => (
          <div class:list={['how-item rise-b', `i${n % 3}`]}>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
