---
import { getEntry } from 'astro:content';

const h = (await getEntry('howIWork', 'main'))!.data;
// Entrance: same as About (motion.css). Heading and lead use .rise-a, the items
// .rise-b, staggered by column (i0-i2).
---

<section id="how" class="sec">
  <div class="wrap">
    <h2 class="h2 rise-a">{h.heading}</h2>
    <p class="lead-p rise-a">{h.lead}</p>
    <div class="how-grid">
      {
        h.items.map((it, n) => (
          <div class:list={['how-item rise-b', `i${n % 3}`]}>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
