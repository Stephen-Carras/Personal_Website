---
import { getEntry } from 'astro:content';

const h = (await getEntry('howIWork', 'main'))!.data;
---

<section id="how" class="sec">
  <div class="wrap">
    <h2 class="h2 rv-u">{h.heading}</h2>
    <p class="lead-p rv-u i1">{h.lead}</p>
    <div class="how-grid">
      {
        h.items.map((it, n) => (
          <div class:list={['how-item rv-u', `i${n % 3}`]}>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
