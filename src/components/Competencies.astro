---
// Expertise & Tools (id "focus"): highlighted chips; "Show all N +" (native <details>)
// replaces them with every item, in labelled blocks (Skills, Tools) of group rows.
// N is computed from the data. Entrance (motion.css): the heading, the chip row and the
// Show all wrapper fade up together on the section's --sec timeline. Show all / Show
// fewer: scripts/comp-morph.ts glides the featured chips to and from their twins.
import { getEntry } from 'astro:content';

const c = (await getEntry('competencies', 'core'))!.data;
const total = c.blocks.reduce((n, b) => n + b.groups.reduce((m, g) => m + g.items.length, 0), 0);
// Running row index across blocks, so the open stagger flows through all rows (d0, d1, ...).
let row = 0;
const blocks = c.blocks.map((b) => ({ ...b, groups: b.groups.map((g) => ({ ...g, d: row++ })) }));
---

<section id="focus" class="sec alt">
  <div class="wrap">
    <h2 class="h2 rise-a">{c.heading}</h2>
    <div class="comp">
      <div class="hl rise-b">
        {c.highlighted.map((name, n) => <span class="comp-chip">{name}</span>)}
      </div>
      <div class="comp-more rise-b">
        <details id="comp-all">
          <summary class="aboutrole">
            <span class="ab-c">{c.showAllLabel.replace('{n}', String(total))}</span>
            <span class="ab-o">{c.showFewerLabel}</span>
          </summary>
          <div class="comp-groups">
            {
              blocks.map((b) => (
                <div class="comp-block">
                  <h3 class:list={['comp-block-h', `d${b.groups[0]!.d}`]}>{b.name}</h3>
                  {b.groups.map((g) => (
                    <div class:list={['comp-row', `d${g.d}`]}>
                      <div class="comp-name">{g.name}</div>
                      <div class="comp-items">
                        {g.items.map((name) => (
                          <span class="comp-item">{name}</span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
