---
// Beyond work: intro, photo gallery with "A little about me", Trips & places, then one
// grid of cards: hobbies (full width), books and music, "Ask me about" and "Now". Carousels are rendered once;
// the script adds loop clones in phase 3. Never put scroll-driven animation classes
// on elements inside the horizontal tracks (MOTION.md); the wrappers carry them.
// Two blocks over one pinned photo (sections.css, motion.css): .bstage > .bpin holds
// the title and intro (pinned on large screens), .bbody everything else. The full-list
// pop-ups sit after the section so they keep the page's normal colours, not the
// section's white-on-photo ones.
import { getEntry } from 'astro:content';
import { inFileOrder } from '../lib/order';
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import ListRow from './ListRow.astro';
import ListDialog from './ListDialog.astro';

const b = (await getEntry('beyond', 'main'))!.data;
const g = (await getEntry('gallery', 'main'))!.data;
const trips = await inFileOrder('trips');
const portrait = img(g.portrait);

// Books and music: cards show featured items; the pop-up lists all of them. The
// "Full list" button and its pop-up exist only when some items are not featured.
const lists = [
  { key: 'books', list: b.books, rows: b.books.items.map((x) => ({ title: x.title, sub: x.author, url: x.url, featured: x.featured })) },
  { key: 'music', list: b.music, rows: b.music.items.map((x) => ({ title: x.name, url: x.url, featured: x.featured })) },
].map((l) => ({
  ...l,
  id: `${l.key}-dlg`,
  featured: l.rows.filter((r) => r.featured),
  hasMore: l.rows.some((r) => !r.featured),
}));
---

<section id="beyond" class="sec beyond">
  <div class="bstage">
    <div class="bpin">
      <h2 class="h2 rise-a">{b.heading}</h2>
      <p class="beyond-intro rise-b">{b.intro}</p>
    </div>
  </div>
  <div class="wrap bbody">
    <div class="gal-row">
      <div class="gal-about rise-b">
        <Image class="gal-mark" src={portrait.src} alt={portrait.alt} width={96} height={96} densities={[1, 2]} loading="lazy" />
        <h3>{g.heading}</h3>
        <p>{g.text}</p>
      </div>
      <div class="gal-col rise-b">
        <div id="galtrack" class="track galtrack" role="region" aria-label="Photo gallery. Swipe or use the arrow buttons." tabindex="0" data-loop>
          {
            g.photos.map((file) => {
              const p = img(file);
              return (
                <figure class="gal-slide">
                  <Image src={p.src} alt={p.alt} widths={[480, 720, 1024]} sizes="(min-width: 1144px) 560px, 88vw" loading="lazy" />
                </figure>
              );
            })
          }
        </div>
        <div class="gal-bar">
          <span>{g.caption}</span>
          <div class="gbtns">
            <button class="ib gb" type="button" data-track-prev="galtrack" aria-label="Previous photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
            </button>
            <button class="ib gb" type="button" data-track-next="galtrack" aria-label="Next photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="trips rise-b">
      <h3 class="h3">{b.tripsHeading}</h3>
      <div id="triptrack" class="track trip-track" role="region" aria-label="Trips and places, scroll horizontally" tabindex="0" data-loop>
        {
          trips.map(({ data: t }) => {
            const p = img(t.photo);
            return (
              <figure class="trip">
                <Image src={p.src} alt={p.alt} widths={[300, 600, 900]} sizes="(min-width: 400px) 300px, 76vw" loading="lazy" />
                <figcaption>
                  <span class="trip-p">{t.place}</span>
                  <span class="trip-c">{t.country}</span>
                </figcaption>
              </figure>
            );
          })
        }
      </div>
    </div>

    <div class="bw-grid">
      <div class="card card--full rise-b">
        <h3 class="h3">{b.hobbies.heading}</h3>
        <div class="tags">{b.hobbies.items.map((t) => <span>{t}</span>)}</div>
      </div>
      {
        lists.map((l) => (
          <div class={`card card--list rise-b`}>
            <h3 class="h3">{l.list.heading}</h3>
            <ul class="llist">
              {l.featured.map((r) => (
                <ListRow title={r.title} sub={r.sub} url={r.url} />
              ))}
            </ul>
            {l.hasMore && (
              <div class="card-foot">
                <button class="list-btn" type="button" aria-haspopup="dialog" data-open-dialog={l.id}>
                  {l.list.fullListLabel} <span aria-hidden="true">›</span>
                </button>
              </div>
            )}
          </div>
        ))
      }
      <div class="card rise-b">
        <h3 class="h3">{b.askMeAbout.heading}</h3>
        <ul class="ask">{b.askMeAbout.items.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="card rise-b">
        <h3 class="h3">{b.now.heading}</h3>
        <div class="now">
          {
            b.now.items.map((n) => (
              <div class="now-r">
                <span class="now-l">{n.label}</span>
                <span class="now-t">{n.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
{
  lists
    .filter((l) => l.hasMore)
    .map((l) => (
      <ListDialog
        id={l.id}
        title={l.list.dialogTitle}
        subtitle={l.list.dialogSubtitle}
        closeLabel={`Close ${l.list.dialogTitle.toLowerCase()}`}
        rows={l.rows}
      />
    ))
}
