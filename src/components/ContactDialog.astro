---
// "Contact me" popup. A native modal <dialog>: the browser traps focus, makes the page
// behind it inert, closes on Escape and exposes it as a modal dialog. The script adds
// backdrop click, scroll lock and focus return. Order: LinkedIn, email + Copy, reply time.
// The email address is filled in at runtime; it never appears in the HTML.
interface Props {
  popup: {
    heading: string;
    intro: string;
    linkedinLabel: string;
    emailLabel: string;
    copyLabel: string;
    copiedLabel: string;
    replyNote: string;
  };
  linkedin: { url: string; label: string };
}
const { popup, linkedin } = Astro.props;
---

<dialog id="cmod" class="cmod" aria-labelledby="cmod-h">
  <div class="cmod-in">
    <button class="ib cmod-x" type="button" data-close-dialog aria-label="Close contact" autofocus>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <h2 id="cmod-h" class="cmod-h">{popup.heading}</h2>
    <p class="cmod-p">{popup.intro}</p>
    <div class="cmod-rows">
      <a class="row" href={linkedin.url} target="_blank" rel="noopener noreferrer">
        <span class="row-txt">
          <span class="row-l">{popup.linkedinLabel}</span>
          <span class="row-v">{linkedin.label}</span>
        </span>
        <span class="row-chev" aria-hidden="true">›</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
      <div class="row-email">
        <a class="row-in" href="#contact" data-email-me>
          <span class="row-txt">
            <span class="row-l">{popup.emailLabel}</span>
            <span class="row-v" data-email-text></span>
          </span>
        </a>
        <button class="chip copy" type="button" aria-label="Copy email address" data-copy-email data-copy={popup.copyLabel} data-copied={popup.copiedLabel}>
          {popup.copyLabel}
        </button>
      </div>
    </div>
    <p class="cmod-note">{popup.replyNote}</p>
    <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
  </div>
</dialog>
