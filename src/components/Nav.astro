---
import { Image } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  name: string;
  links: { label: string; href: string }[];
}
const { name, links } = Astro.props;
const mark = img('mark.jpg');
---

<a class="skip" href="#main">Skip to content</a>
<nav class="nav" aria-label="Primary">
  <div class="nav-in">
    <a class="nav-home" href="#top">
      <Image class="nav-mark" src={mark.src} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
      {name}
    </a>
    <div class="nav-right">
      <div class="navl">
        {links.map((l) => <a class="navk" href={l.href}>{l.label}</a>)}
      </div>
      <button class="nav-search" type="button" data-open-search aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K /">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span class="nav-search-t">Search</span><span class="sr-only"> this site</span>
        <kbd class="nav-kbd" aria-hidden="true" data-kbd>⌘K</kbd>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
  <div class="prog" aria-hidden="true"></div>
</nav>
